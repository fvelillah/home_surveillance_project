[Unit]
Description=Dahua Surveillance Platform - Edge Ingestion & Triage Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=surveillance
Group=surveillance
WorkingDirectory=/opt/home_surveillance_project
EnvironmentFile=/opt/home_surveillance_project/.env
ExecStart=/opt/home_surveillance_project/.venv/bin/python -m uvicorn edge.main:app --host 0.0.0.0 --port 7777 --workers 1
Restart=always
RestartSec=5s
Nice=-5
StandardOutput=append:/opt/home_surveillance_project/data/storage/edge_service.log
StandardError=append:/opt/home_surveillance_project/data/storage/edge_service.err
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
