[Unit]
Description=Dahua Surveillance Platform - Next.js Cyber-Defense Console
After=network-online.target surveillance-backend.service
Wants=network-online.target

[Service]
Type=simple
User=surveillance
Group=surveillance
WorkingDirectory=/opt/home_surveillance_project/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5s
StandardOutput=append:/opt/home_surveillance_project/data/storage/frontend_service.log
StandardError=append:/opt/home_surveillance_project/data/storage/frontend_service.err
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
