# ==============================================================================
# Dahua Home Surveillance - Environment Configuration (.env.example)
# ==============================================================================

# --- Dahua NVR Connection ---
DAHUA_NVR_IP=192.168.1.100
DAHUA_NVR_HTTP_PORT=80
DAHUA_NVR_USER=admin
DAHUA_NVR_PASSWORD=your_secure_password
DAHUA_NUM_CAMERAS=9

# URL Templates for Direct HTTP Video Engine
DAHUA_SUBSTREAM_URL_TEMPLATE="http://{user}:{password}@{ip}:{port}/cgi-bin/mjpg/video.cgi?channel={channel}&subtype=1"
DAHUA_MAINSTREAM_URL_TEMPLATE="http://{user}:{password}@{ip}:{port}/cgi-bin/mjpg/video.cgi?channel={channel}&subtype=0"
DAHUA_SNAPSHOT_URL_TEMPLATE="http://{user}:{password}@{ip}:{port}/cgi-bin/snapshot.cgi?channel={channel}"

# Friendly names mapped to channel IDs
CAMERA_NAMES="1:Front Door,2:Driveway,3:Front Yard,4:Garage,5:Back Patio,6:Backyard,7:Side Alley North,8:Side Alley South,9:Perimeter Gate"

# --- Ingestion & Worker Knobs ---
INGEST_FPS=10
FRAME_BUFFER_CAPACITY_SEC=30
RECONNECT_INITIAL_DELAY_SEC=1.0
RECONNECT_MAX_DELAY_SEC=30.0
STREAM_READ_TIMEOUT_SEC=5.0

# --- Sliding Window Segmentation Knobs ---
CLIP_DURATION_S=10.0
CLIP_OVERLAP_S=2.0
SEGMENT_SAMPLE_FRAMES=16
SEGMENT_TARGET_WIDTH=224
SEGMENT_TARGET_HEIGHT=224

# --- Storage Paths ---
STORAGE_DIR="./data/storage"
INCIDENT_CLIPS_DIR="./data/storage/incidents"
SNAPSHOTS_DIR="./data/storage/snapshots"

# --- Edge API Service ---
EDGE_HOST="0.0.0.0"
EDGE_PORT=7777

# --- Synthetic Feed Simulator (for testing without physical NVR) ---
MOCK_SIMULATOR_PORT=8888
MOCK_SIMULATOR_NUM_CAMERAS=9

# --- Phase 2: Edge Feature Extractor Knobs (PyTorch) ---
# Model backbone: "mobilenet_v3" or "efficientnet_b0"
MODEL_TYPE="mobilenet_v3"
EMBEDDING_DIM=576

# --- Phase 2: Qdrant Edge Two-Shard Knobs ---
# Local embedded Qdrant directory (no external server required)
QDRANT_EDGE_PATH="./data/qdrant_edge"
# Optional remote Qdrant URL if using external cluster
# QDRANT_EDGE_URL="http://localhost:6333"
# High-recall triage threshold for escalation to central cloud
EDGE_TRIAGE_THRESHOLD=0.060
# Number of nearest neighbors for kNN anomaly distance
EDGE_TOP_K=5
# Weighting factor for baseline shard vs recent context (0.0 to 1.0)
EDGE_ALPHA_BASELINE=0.7
# Maximum number of rolling points in mutable recent context shard per camera
EDGE_MUTABLE_MAX_POINTS=200

# --- Phase 2: SQLite Offline Queue & Auto-Drain Knobs ---
SQLITE_QUEUE_PATH="./data/storage/offline_queue.db"
CENTRAL_BACKEND_URL="http://localhost:9876"
DRAIN_SYNC_INTERVAL_S=5.0
DRAIN_MAX_RETRIES=5
TRIAGE_POLL_INTERVAL_S=1.0

# --- Phase 3: Central Cloud Backend & Model Server ---
CENTRAL_HOST="0.0.0.0"
CENTRAL_PORT=9876
MODEL_SERVER_URL="http://localhost:9877"

# --- Phase 3: Central Qdrant Baseline Cluster ---
QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY="your-qdrant-api-key"
COLLECTION_NAME="anomaly_baseline"
CLOUD_ANOMALY_THRESHOLD=0.15
ESCALATION_THRESHOLD=0.15
CONFIRMATION_K=5

# --- Phase 3: Multi-Model Ensemble Scoring ---
ENSEMBLE_CLOUD_WEIGHT=0.7
ENSEMBLE_EDGE_WEIGHT=0.3
ENSEMBLE_THRESHOLD=0.15
TEMPORAL_BOOST_WINDOW=5.0
TEMPORAL_BOOST_FACTOR=0.1
MAX_TEMPORAL_BOOST=0.3

# --- Phase 3: Twelve Labs Cloud VLM Engine ---
# TWELVE_LABS_API_KEY="tlk_your_twelve_labs_api_key"
TWELVE_LABS_API_URL="https://api.twelvelabs.io/v1.3"
TWELVE_LABS_MARENGO_INDEX_NAME="dahua-surveillance-marengo"
TWELVE_LABS_PEGASUS_INDEX_NAME="dahua-surveillance-pegasus"
TWELVE_LABS_MARENGO_MODEL="marengo2.7"
TWELVE_LABS_PEGASUS_MODEL="pegasus1.5"
TWELVE_LABS_UPLOAD_TIMEOUT=600
TWELVE_LABS_MAX_CLIPS=10

# --- Phase 4: Incident Formation & Hysteresis Knobs ---
EMA_ALPHA=0.3
INCIDENT_START_THRESHOLD=0.080
INCIDENT_END_THRESHOLD=0.050
COOLDOWN_WINDOW_S=30.0

# --- Phase 4: Memory Governor & Anti-Poisoning Knobs ---
QUARANTINE_COLLECTION_NAME="anomaly_quarantine"
QUARANTINE_DURATION_S=3600
MAX_VECTORS_PER_CAMERA=500
BASELINE_RETENTION_DAYS=7
ANTI_POISONING_THRESHOLD=0.080

# --- Phase 4: Streaming Backpressure & Load Shedding Knobs ---
LOAD_SHED_AUTO=true
LOAD_SHED_SCORE_ONLY_LATENCY_MS=500.0
LOAD_SHED_PASSTHROUGH_LATENCY_MS=1500.0
LOAD_SHED_CRITICAL_THRESHOLD=0.25

